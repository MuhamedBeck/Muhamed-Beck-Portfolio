# Response headers for Cloudflare Workers Static Assets.
# Mirrors the header rules that vercel.json defines, so the site behaves the
# same on either host. Copied verbatim into dist/ by Vite.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  # Tells browsers to use HTTPS for a year after the first visit. This only
  # covers repeat visitors; the first plain-HTTP request still needs Cloudflare's
  # "Always Use HTTPS" redirect. No "preload" directive: that would enrol the
  # domain in a browser-baked list which is slow and awkward to undo.
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Hashed filenames, so the content behind a URL never changes.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
