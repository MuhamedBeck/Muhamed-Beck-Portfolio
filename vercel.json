{
  "rewrites": [
    {
      "source": "/:file(sitemap.xml|robots.txt|favicon.ico)",
      "destination": "/:file"
    },
    {
      "source": "/:static(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot)/:file",
      "destination": "/:static/:file"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        }
      ]
    }
  ]
}
