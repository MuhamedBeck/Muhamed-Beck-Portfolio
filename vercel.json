{
  "rewrites": [
    {
      "source": "/:file(sitemap.xml|robots.txt|favicon.ico)",
      "destination": "/:file"
    },
    {
      "source": "/assets/:file*",
      "destination": "/assets/:file*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        }
      ]
    }
  ]
}
